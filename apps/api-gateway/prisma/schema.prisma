generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../node_modules/.prisma/client-gateway"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_GATEWAY")
  schemas  = ["gateway"]
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
  @@schema("gateway")
}
