              "path": ["preferences"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get prefs returns 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const json = pm.response.json();",
                  "pm.test('channel = EMAIL', () => pm.expect(json.channel).to.equal('EMAIL'));",
                  "pm.test('enabled = true', () => pm.expect(json.enabled).to.equal(true));"
                ]
              }
            }
          ]
