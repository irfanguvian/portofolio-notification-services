                "type": "text/javascript",
                "exec": [
                  "pm.test('prefs set returns 200/201', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Preferences",
          "request": {
            "method": "GET",
