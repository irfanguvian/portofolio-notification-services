                "exec": [
                  "pm.test('invalid prefs returns 400', () => pm.expect(pm.response.code).to.equal(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Preferences",
      "item": [
        {
          "name": "Set Preferences",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
