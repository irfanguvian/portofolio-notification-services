{
  "info": {
    "_postman_id": "9c4a3a1f-1234-4abc-9def-acumen-coll-0001",
    "name": "Acumen — Portfolio Activity & Notification System",
    "description": "Per-step API journey across all three Acumen apps. Run order mirrors scripts/user-journey.mjs and docs/USER_JOURNEY.md (steps 01..13).\n\n  newman run postman/Acumen.postman_collection.json -e postman/Acumen.postman_environment.json --bail --delay-request 500\n\nVariables (token, userId, transactionId, notificationId) are captured by test scripts and chained automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "  pm.environment.set('baseUrl', 'http://localhost:3000');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "console.log('[' + name + '] status=' + pm.response.code + ' time=' + pm.response.responseTime + 'ms');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["healthz"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('healthz returns 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const json = pm.response.json();",
                  "pm.test('status field present', () => pm.expect(json).to.have.property('status'));",
                  "pm.test('checks include downstream rpc keys', () => {",
                  "  pm.expect(json).to.have.property('checks');",
                  "  pm.expect(json.checks).to.have.property('db');",
                  "  pm.expect(json.checks).to.have.property('rmq');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 200/201/409', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.token) pm.environment.set('token', json.token);",
                  "  if (json && json.userId) pm.environment.set('userId', json.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const json = pm.response.json();",
                  "pm.test('token present', () => pm.expect(json).to.have.property('token').that.is.a('string'));",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('userId', json.userId);",
                  "pm.environment.set('pollAttempt', '0');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Negative",
      "item": [
        {
          "name": "Unauthenticated Tx → 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"AAPL\",\n  \"type\": \"BUY\",\n  \"qty\": 1,\n  \"price\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/portfolio/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["portfolio", "transactions"]
