          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthed returns 401', () => pm.expect(pm.response.code).to.equal(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Prefs → 400",
          "request": {
            "method": "POST",
