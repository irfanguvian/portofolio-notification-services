    },
    {
      "name": "05 Rules",
      "item": [
        {
          "name": "Set Rule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"TRADE_EXECUTED\",\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["rules"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rules set returns 200/201', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Portfolio",
      "item": [
        {
          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "content-type", "value": "application/json" },
              { "key": "authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{lastTxSymbol}}\",\n  \"type\": \"{{lastTxType}}\",\n  \"qty\": {{lastTxQty}},\n  \"price\": {{lastTxPrice}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/portfolio/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["portfolio", "transactions"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const symbols = ['AAPL', 'MSFT', 'NVDA', 'AMZN', 'TSLA'];",
                  "const symbol = symbols[Math.floor(Math.random() * symbols.length)];",
                  "const type = Math.random() < 0.5 ? 'BUY' : 'SELL';",
                  "const qty = Number((Math.random() * 9 + 1).toFixed(4));",
                  "const price = Number((Math.random() * 500 + 10).toFixed(2));",
                  "pm.environment.set('lastTxSymbol', symbol);",
                  "pm.environment.set('lastTxType', type);",
                  "pm.environment.set('lastTxQty', qty);",
                  "pm.environment.set('lastTxPrice', price);",
                  "pm.environment.set('pollAttempt', '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create tx returns 200/201/202', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.environment.set('transactionId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/portfolio/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["portfolio", "transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list tx returns 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const body = pm.response.json();",
                  "const list = Array.isArray(body) ? body : (body && Array.isArray(body.data) ? body.data : []);",
                  "pm.test('list non-empty', () => pm.expect(list.length).to.be.greaterThan(0));",
                  "const txId = pm.environment.get('transactionId');",
                  "if (txId) {",
                  "  pm.test('contains created transactionId', () => {",
                  "    pm.expect(list.some((t) => t && t.id === txId)).to.equal(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 Notifications",
      "item": [
        {
          "name": "Poll",
          "request": {
            "method": "GET",
            "header": [{ "key": "authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('notifications returns 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const body = pm.response.json();",
                  "const list = Array.isArray(body) ? body : (body && Array.isArray(body.data) ? body.data : []);",
                  "const sent = list.filter((n) => n && n.eventType === 'TRADE_EXECUTED' && n.status === 'SENT');",
                  "const attempt = parseInt(pm.environment.get('pollAttempt') || '0', 10) + 1;",
                  "const max = parseInt(pm.environment.get('pollMax') || '10', 10);",
                  "pm.environment.set('pollAttempt', String(attempt));",
                  "if (sent.length > 0) {",
                  "  pm.test('SENT notification observed', () => pm.expect(sent.length).to.be.greaterThan(0));",
                  "  pm.environment.set('notificationId', sent[0].id);",
                  "} else if (attempt < max) {",
                  "  console.log('[poll] attempt ' + attempt + '/' + max + ' — no SENT yet, retrying');",
                  "  pm.execution.setNextRequest('Poll');",
                  "} else {",
                  "  pm.expect.fail('no SENT TRADE_EXECUTED notification after ' + max + ' attempts');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
