POSTGRES_USER=acumen
POSTGRES_PASSWORD=acumen
POSTGRES_DB=acumen
RABBITMQ_USER=acumen
RABBITMQ_PASSWORD=acumen
JWT_SECRET=change-me-to-32-plus-chars-secret-key
GATEWAY_PORT=3000
PORTFOLIO_HEALTH_PORT=3001
NOTIFICATION_HEALTH_PORT=3002
# Host port mappings (avoid collision with native postgres/rabbitmq/redis on 5432/5672/15672/6379)
POSTGRES_HOST_PORT=55432
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673
REDIS_HOST_PORT=6380
DATABASE_URL_GATEWAY=postgresql://acumen:acumen@localhost:55432/acumen?schema=gateway
DATABASE_URL_PORTFOLIO=postgresql://acumen:acumen@localhost:55432/acumen?schema=portfolio
DATABASE_URL_NOTIFICATION=postgresql://acumen:acumen@localhost:55432/acumen?schema=notification
RABBITMQ_URL=amqp://acumen:acumen@localhost:5673
REDIS_URL=redis://localhost:6380
NODE_ENV=development
LOG_LEVEL=info
